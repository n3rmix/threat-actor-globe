{
  "name": "threat-actor-globe",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Realtime global cyber threat actor activity globe powered by GDELT, deck.gl, React, Fastify, and SQLite.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "ingest": "tsx server/ingest.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "bash scripts/start.sh",
    "stop": "bash scripts/stop.sh",
    "preview": "vite preview"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.0.0",
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@heroui/react": "^3.2.1",
    "@heroui/styles": "^3.2.1",
    "csv-parse": "^5.5.6",
    "fastify": "^4.28.1",
    "framer-motion": "^12.42.2",
    "maplibre-gl": "^4.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.7.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
